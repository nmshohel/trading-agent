{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @trading-agent/shared build && pnpm --filter @trading-agent/api db:generate && pnpm --filter @trading-agent/api build",
  "outputDirectory": "apps/api/public",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 30,
      "includeFiles": "node_modules/.pnpm/@prisma+client*/node_modules/.prisma/client/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ]
}
