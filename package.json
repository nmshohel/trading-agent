{
  "name": "trading-agent-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Personal AI Forex Trading Agent (Exness MT5, XAUUSD, Semi-Automatic)",
  "packageManager": "pnpm@10.29.1",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev:api": "pnpm --filter @trading-agent/api dev",
    "dev:web": "pnpm --filter @trading-agent/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @trading-agent/api db:generate",
    "db:migrate": "pnpm --filter @trading-agent/api db:migrate",
    "db:push": "pnpm --filter @trading-agent/api db:push",
    "db:seed": "pnpm --filter @trading-agent/api db:seed",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp"
    ]
  }
}
