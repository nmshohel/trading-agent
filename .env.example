# ==============================================================================
# Personal AI Forex Trading Agent — Environment Example (Placeholders Only)
# Copy to .env (never commit real secrets or credentials)
# ==============================================================================

NODE_ENV=development
API_PORT=5000
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=/api

# PostgreSQL (matches infra/docker-compose.yml dev defaults)
DATABASE_URL=postgresql://trading_agent:change_me_pg_password@127.0.0.1:5432/trading_agent?schema=public

# Redis (matches infra/docker-compose.yml dev defaults)
REDIS_URL=redis://:change_me_redis_password@127.0.0.1:6379
REDIS_STREAM_COMMANDS=commands:trading
REDIS_PUBSUB_CHANNEL=events:sse

# Authentication & Internal Worker Security (use 64+ char random secrets)
APP_SESSION_SECRET=replace_with_at_least_32_char_random_session_secret_value
SESSION_COOKIE_NAME=ta_session
SESSION_TTL_HOURS=24
OWNER_EMAIL=owner@local.dev
OWNER_PASSWORD=ChangeMe123!StrongPassword

WORKER_API_BASE_URL=http://127.0.0.1:5000
WORKER_AUTH_TOKEN=replace_with_at_least_32_char_random_worker_auth_token

# Exness MT5 Worker Configuration (Windows host only — store MT5 password in Windows Credential Manager)
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_ACCOUNT_LOGIN=DEMO_ACCOUNT_NUMBER
MT5_ACCOUNT_SERVER=Exness-MT5Demo
MT5_ACCOUNT_MODE=DEMO
MT5_ACCOUNT_TYPE=CENT
MT5_SYMBOL=XAUUSDc
MT5_MAGIC_NUMBER=260101

# OpenAI Analysis Service (server-side only; advisory commentary/veto)
OPENAI_API_KEY=replace_with_server_side_openai_key
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=5
AI_FALLBACK_MODE=DETERMINISTIC_ONLY
